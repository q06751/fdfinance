{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://0.0.0.0:5050",
  "ConnectionStrings": {
    "FinanceDb": "Data Source=/workspace/data/fdfinance.db",
    "Redis": "localhost:6379"
  },
  "Database": {
    "Provider": "Sqlite",
    "EnsureCreated": true,
    "Comment": "接老库：Provider=SqlServer + EnsureCreated=false + 执行 scripts/legacy-compatible-additions.sql + Password:WriteMode=LegacyMd5。详见 scripts/connect-legacy-sqlserver.md"
  },
  "Redis": {
    "Enabled": "true",
    "Configuration": "localhost:6379"
  },
  "Jwt": {
    "Key": "FdFinance-Dev-Secret-Key-At-Least-32-Chars!!",
    "Issuer": "FdFinance",
    "Audience": "FdFinance.Client",
    "ExpireHours": "12"
  },
  "Password": {
    "WriteMode": "Bcrypt",
    "Comment": "双跑老库必须 LegacyMd5；见 scripts/connect-legacy-sqlserver.md"
  },
  "App": {
    "PublicUrl": "",
    "SignatureDir": "/workspace/data/signatures"
  },
  "Cors": {
    "Origins": [ "*" ]
  },
  "DingTalk": {
    "Enabled": false,
    "Webhook": "",
    "Secret": "",
    "AppBaseUrl": ""
  },
  "Swagger": {
    "Enabled": true
  }
}
